rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read and write for reviews (Website & Android app)
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Public read and write for team members (Website & Android app)
    match /team_members/{memberId} {
      allow read, write: if true;
    }

    // Site settings read and write
    match /site_settings/{settingsId} {
      allow read, write: if true;
    }

    // Contact inquiries
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Permanent global rule (No 30-day expiration timer)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
